# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public base URL used in WhatsApp member-portal links (e.g. https://your-app.vercel.app).
# Leave unset to use the current site origin automatically.
NEXT_PUBLIC_APP_URL=

# Receipt scanning (optional — falls back to OCR if missing)
# GEMINI_MODEL overrides the model chain (comma-separated), default: gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=

# Admin credentials (fallbacks are hardcoded in lib/auth.ts if unset)
ADMIN_EMAIL=admin@chitfund.com
ADMIN_PASSWORD=admin@123
ADMIN_SESSION_SECRET=replace-with-a-long-random-string